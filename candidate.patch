+++ b/experiments/vessels-3d/bio/lessons/contract.mjs
@@ -0,0 +1,24 @@
+// Bounded semantic scene: chromosome number is conserved by mitosis.
+export function validateLesson(job) {
+ const stop=m=>{throw new Error('BIO_LESSON_STOP: '+m);};
+ if(job?.version!=='bio-mitosis-lesson-v1'||job.scene_family!=='mitosis-chromosome-count')stop('unsupported family');
+ if(job.scope!=='ege_biology_3'||job.account!=='ege_biology'||job.playback_speed!==1||job.render_fps!==60)stop('scope/pacing mismatch');
+ if(!Number.isSafeInteger(job.chromosomes)||job.chromosomes<1||job.chromosomes>120||job.answer!==job.chromosomes)stop('mitosis must conserve chromosome count, 1..120');
+ for(const key of ['condition_text','parent_label','daughter_label'])if(typeof job[key]!=='string'||!job[key].trim()||job[key].length>(key==='condition_text'?700:40))stop('invalid '+key);
+ if(!/митоз/iu.test(job.condition_text)||job.ploidy!==1||!/заростк/iu.test(job.condition_text)||!/папоротник/iu.test(job.condition_text)||!/яйцеклетк/iu.test(job.condition_text))stop('this preview supports haploid fern gametophyte mitosis only');
+ const known=job.condition_text.match(/содержащ[а-яё]*\s+(\d+)\s+хромосом/iu);
+ if(!known||Number(known[1])!==job.chromosomes||!/сколько хромосом содержит клетка заростка/iu.test(job.condition_text))stop('unrecognized given quantity or target');
+ const tl=job.timeline;
+ if(!tl||tl.version!=='bio-measured-timeline-v1'||tl.playback_speed!==1||!Number.isFinite(tl.total)||tl.total>90)stop('measured timeline required');
+ if(tl.segments?.map(s=>s.id).join(',')!=='intro,task,step-1,step-2,cta')stop('two-step lesson required');
+ if(tl.pause?.duration!==5.6)stop('approved pause required');
+ let end=0;
+ for(const s of tl.segments){if(!Number.isFinite(s.start)||!Number.isFinite(s.end)||s.start<end||s.end<=s.start||s.end>tl.total)stop('invalid segment timing');end=s.end;}
+ if(tl.pause.start<tl.segments[1].end||tl.pause.end>tl.segments[2].start)stop('pause intersects speech');
+ for(const [key,id] of [['known','task'],['mitosis','step-2'],['answer','step-2']]){
+  const c=job.cues?.[key],s=tl.segments.find(s=>s.id===id);
+  if(!c||c.segment_id!==id||!Number.isFinite(c.start)||!Number.isFinite(c.end)||c.start<s.start||c.end>s.end||c.end<=c.start)stop('invalid '+key+' cue');
+ }
+ if(job.cues.answer.start<=job.cues.mitosis.start)stop('answer must follow explanation');
+ return job;
+}
