+#!/usr/bin/env python3
+"""Strict image gate with a same-source control for Chromium rounding noise.
+
+No perceptual similarity metric: at most one 8-bit level in 0.01% of pixels,
+and only on frames where two independent renders of the immutable source
+also differ within those same limits. Any larger change fails.
+"""
+import json
+import subprocess
+from pathlib import Path
+import numpy as np
+
+
+def stats(a,b):
+    delta=np.abs(a.astype(np.int16)-b.astype(np.int16))
+    changed=np.any(delta,axis=2)
+    return {'changed_pixels':int(np.count_nonzero(changed)), 'max_channel_delta':int(delta.max())}
+
+
+def acceptable(candidate,control,pixels):
+    limit=max(1,int(pixels*.0001))
+    exact=candidate['changed_pixels']==0
+    bounded=lambda d: 0<d['changed_pixels']<=limit and d['max_channel_delta']<=1
+    return exact or (bounded(candidate) and bounded(control))
+
+
+def main():
+    root=Path(__file__).resolve().parent/'out/visual-regression'
+    report=json.loads((root/'report.json').read_text())
+    def read(name):
+        raw=subprocess.check_output(['ffmpeg','-v','error','-i',str(root/name),'-f','rawvideo','-pix_fmt','rgb24','-'])
+        return np.frombuffer(raw,dtype=np.uint8).reshape(1920,1080,3)
+    for frame in report['times']:
+        t=frame['t'];a=read(f'approved-{t}.png')
+        c=stats(a,read(f'candidate-{t}.png'));control=stats(a,read(f'control-{t}.png'))
+        frame.update(candidate_pixels=c,control_pixels=control,pixel_gate_passed=acceptable(c,control,1920*1080))
+        print(json.dumps(frame))
+    report['pixel_gate']={'max_channel_delta':1,'max_changed_fraction':.0001,'requires_same_source_control_noise':True}
+    report['passed']=not report['errors'] and report['audio_identical'] and all(f['pixel_gate_passed'] for f in report['times'])
+    (root/'report.json').write_text(json.dumps(report,indent=2)+'\n')
+    if not report['passed']:raise SystemExit('Reference fidelity gate FAILED')
+    print('Reference fidelity gate PASSED; exact and rounding-limited frames are reported separately')
+
+if __name__=='__main__':main()
