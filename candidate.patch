+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {assemblePcm} from './prepare-audio.mjs';
+test('copies every sample and inserts exact digital silence',()=>{
+ const source=Buffer.alloc(20*48000*4,91);
+ const timeline={version:'bio-measured-timeline-v1',playback_speed:1,intro_seconds:2,pause:{source_seconds:7.125,duration:5.6},total:28.2};
+ const {output,introBytes,pauseBytes,splitBytes}=assemblePcm(source,timeline);
+ assert.ok(output.subarray(0,introBytes).every(x=>x===0));
+ assert.ok(output.subarray(introBytes,introBytes+splitBytes).equals(source.subarray(0,splitBytes)));
+ assert.ok(output.subarray(introBytes+splitBytes,introBytes+splitBytes+pauseBytes).every(x=>x===0));
+ assert.ok(output.subarray(introBytes+splitBytes+pauseBytes,introBytes+pauseBytes+source.length).equals(source.subarray(splitBytes)));
+ assert.ok(output.subarray(introBytes+pauseBytes+source.length).every(x=>x===0));
+});
+test('rejects truncation and unintended speed changes',()=>{
+ const source=Buffer.alloc(20*48000*4);
+ const tl={version:'bio-measured-timeline-v1',playback_speed:1,intro_seconds:2,pause:{source_seconds:7,duration:5.6},total:10};
+ assert.throws(()=>assemblePcm(source,tl),/fit/);
+ tl.total=28;tl.playback_speed=1.2;assert.throws(()=>assemblePcm(source,tl),/Invalid/);
+});
