+++ b/approved-adapter/elevenlabs-timeline.mjs
@@ -0,0 +1,84 @@
+// Offline bridge for the approved Three.js design. Does not dispatch or publish.
+import {createHash} from 'node:crypto';
+const stop = message => { throw new Error(`BIO_TIMING_STOP: ${message}`); };
+const finite = n => typeof n === 'number' && Number.isFinite(n);
+const round = n => Math.round(n * 1e6) / 1e6;
+const spoken = s => /[\p{L}\p{N}]/u.test(s);
+
+export function buildMeasuredTimeline({payload, alignment, audioBytes, audioDuration}) {
+  if (!payload || payload.exam !== 'ЕГЭ' || !/биолог/iu.test(payload.subject || '')
+    || payload.task_number !== 3 || payload.scope !== 'ege_biology_3' || payload.account !== 'ege_biology') stop('wrong factory scope');
+  if (typeof payload.id !== 'string' || !payload.id || !payload.condition_text?.trim()) stop('missing task identity/condition');
+  if (!(audioBytes instanceof Uint8Array) || audioBytes.length < 1000 || !finite(audioDuration) || audioDuration <= 0) stop('audio bytes/duration required');
+  const segments = payload.narration_segments;
+  const steps = payload.solution_steps;
+  if (!Array.isArray(steps) || steps.length < 1 || steps.length > 4 || !Array.isArray(segments)) stop('invalid solution structure');
+  const ids = ['intro', 'task', ...steps.map((s,i) => `step-${i+1}`), 'cta'];
+  if (segments.map(s => s.id).join(',') !== ids.join(',') || steps.some((s,i) => s.id !== ids[i+2])) stop('segment identity/order mismatch');
+  if (segments.some(s => typeof s.tts_text !== 'string' || !s.tts_text.trim())) stop('missing actual TTS text');
+  const transcript = segments.map(s => s.tts_text).join('\n\n');
+  if (transcript !== payload.voiceover_tts_text) stop('segments do not reconstruct exact submitted transcript');
+  const chars = alignment?.characters, starts = alignment?.character_start_times_seconds, ends = alignment?.character_end_times_seconds;
+  if (!Array.isArray(chars) || !chars.length || !Array.isArray(starts) || !Array.isArray(ends)
+    || chars.length !== starts.length || chars.length !== ends.length || chars.join('') !== transcript) stop('alignment transcript/array mismatch');
+  let offset = 0;
+  const ranges = chars.map((char,i) => {
+    if (typeof char !== 'string' || !char.length || !finite(starts[i]) || !finite(ends[i]) || starts[i] < 0
+      || ends[i] < starts[i] || ends[i] > audioDuration + .08 || (i && (starts[i] < starts[i-1] || ends[i] < ends[i-1]))) stop(`invalid character timing ${i}`);
+    const range = {from:offset,to:offset+char.length,index:i}; offset += char.length; return range;
+  });
+  const measure = (from,to) => {
+    const matching = ranges.filter(r => r.from >= from && r.to <= to && spoken(chars[r.index]));
+    if (!matching.length || !ranges.some(r => r.from === from) || !ranges.some(r => r.to === to)) stop('text range does not align to characters');
+    const start = starts[matching[0].index], end = ends[matching.at(-1).index];
+    if (end <= start) stop('empty spoken interval');
+    return {start,end};
+  };
+  let cursor = 0;
+  const measured = segments.map((s,i) => {
+    const from = cursor, to = from+s.tts_text.length;
+    const interval = measure(from,to); cursor = to+(i===segments.length-1?0:2);
+    return {...s,source_start:interval.start,source_end:interval.end,from,to};
+  });
+  for (let i=1;i<measured.length;i++) if (measured[i].source_start < measured[i-1].source_end) stop('overlapping spoken segments');
+  // Verify the existing factory timing instead of trusting a provenance label.
+  const existing = payload.narration_timing;
+  if (existing?.source !== 'elevenlabs-character-alignment-v1' || existing.segments?.length !== measured.length) stop('missing factory timing');
+  measured.forEach((s,i) => {
+    const old = existing.segments[i];
+    if (old.id !== s.id || old.tts_text !== s.tts_text || !finite(old.start_sec) || !finite(old.end_sec)
+      || Math.abs(old.start_sec-s.source_start) > .002 || Math.abs(old.end_sec-s.source_end) > .002) stop(`factory timing disagrees for ${s.id}`);
+  });
+  // Insert silence inside the measured gap; never trim, resynthesise or stretch speech.
+  const introSeconds = 2, pauseSeconds = 5.6;
+  const pauseSource = (measured[1].source_end + measured[2].source_start)/2;
+  if (measured[2].source_start-measured[1].source_end < .02) stop('no safe gap after condition for pause insertion');
+  const videoTime = time => round(time+introSeconds+(time >= pauseSource ? pauseSeconds : 0));
+  const ctaStart = videoTime(measured.at(-1).source_start);
+  const total = round(Math.max(audioDuration+introSeconds+pauseSeconds+.6, ctaStart+3.65));
+  if (total > 90) stop('approved pacing exceeds 90 seconds; shorten script before generating speech');
+  const timeline = {
+    version:'bio-measured-timeline-v1', task_id:payload.id,
+    playback_speed:1, render_fps:60, intro_seconds:introSeconds, total,
+    audio:{sha256:createHash('sha256').update(audioBytes).digest('hex'),duration_seconds:audioDuration,
+      transcript_sha256:createHash('sha256').update(transcript).digest('hex'),timing_source:'elevenlabs-character-alignment-v1'},
+    pause:{source_seconds:round(pauseSource),start:round(pauseSource+introSeconds),duration:pauseSeconds,end:round(pauseSource+introSeconds+pauseSeconds)},
+    segments:measured.map(({from,to,source_start,source_end,...s}) => ({...s,source_start,source_end,start:videoTime(source_start),end:videoTime(source_end)})),
+  };
+  // Explicit exact text anchors, not percentages of segment duration. Repeated
+  // phrases must name their occurrence so a result cannot silently appear early.
+  function cue(segmentId, quote, occurrence) {
+    const segment = measured.find(s => s.id === segmentId);
+    if (!segment || typeof quote !== 'string' || !quote.trim()) stop('invalid cue segment/quote');
+    const positions=[]; let at=0;
+    while ((at=segment.tts_text.indexOf(quote,at)) !== -1) {positions.push(at);at+=quote.length;}
+    if (!positions.length || (occurrence===undefined && positions.length!==1)
+      || (occurrence!==undefined && (!Number.isSafeInteger(occurrence) || occurrence<0 || occurrence>=positions.length))) stop('missing/ambiguous spoken cue');
+    const index=positions[occurrence ?? 0], from=segment.from+index, to=from+quote.length;
+    const before=segment.tts_text.slice(0,index).at(-1), after=segment.tts_text.slice(index+quote.length)[0];
+    if ((spoken(quote[0]) && before && spoken(before)) || (spoken(quote.at(-1)) && after && spoken(after))) stop('cue cuts through a spoken word');
+    const {start,end}=measure(from,to);
+    return {segment_id:segmentId,quote,source_start:start,source_end:end,start:videoTime(start),end:videoTime(end)};
+  }
+  return {timeline,cue};
+}
