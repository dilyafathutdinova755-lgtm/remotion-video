+import importlib.util
+import unittest
+from pathlib import Path
+spec=importlib.util.spec_from_file_location('compare_frames',Path(__file__).with_name('compare-frames.py'))
+module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)
+
+def d(count,delta):return {'changed_pixels':count,'max_channel_delta':delta}
+
+class PixelGateTests(unittest.TestCase):
+    def test_exact_pixels_pass(self):self.assertTrue(module.acceptable(d(0,0),d(0,0),2073600))
+    def test_measured_rounding_with_control_passes(self):self.assertTrue(module.acceptable(d(122,1),d(27,1),2073600))
+    def test_no_control_noise_fails(self):self.assertFalse(module.acceptable(d(122,1),d(0,0),2073600))
+    def test_two_level_change_fails(self):self.assertFalse(module.acceptable(d(1,2),d(27,1),2073600))
+    def test_excess_area_fails(self):self.assertFalse(module.acceptable(d(208,1),d(27,1),2073600))
+
+if __name__=='__main__':unittest.main()
