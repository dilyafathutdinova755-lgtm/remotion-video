+// A deliberately bounded adapter, not a universal biology scene generator.
+// No TTS calls, network requests, publication or production-state writes.
+export const VERSION = 'bio-approved-adapter-v1';
+export const FAMILY = 'protein-template-nucleotides';
+export const APPROVED_COMMIT = '2a03f2954c379e5d9ef0d09ac616d8bcb560f5a8';
+const requiredMarks = ['bel', 'quantity', 'amino', 'q', 'dna', 'code', 'h1',
+  'trip', 'three', 'h2', 'x3', 'calc', 'result', 'h3', 'tpl', 'two', 'fin',
+  'answer', 'cta', 'link'];
+const fail = message => { throw new Error(`BIO_ADAPTER_STOP: ${message}`); };
+const number = value => typeof value === 'number' && Number.isFinite(value);
+function text(value, label, max = 300) {
+  if (typeof value !== 'string' || !value.trim() || value.length > max)
+    fail(`${label}: expected nonempty text, max ${max} characters`);
+  return value;
+}
+
+export function validateJob(job) {
+  if (!job || typeof job !== 'object' || Array.isArray(job)) fail('missing job');
+  if (job.version !== VERSION || job.scene_family !== FAMILY) fail('unsupported scene family/version');
+  text(job.task_id, 'task_id', 160);
+  if (job.exam !== 'ЕГЭ' || job.subject !== 'биология' || job.task_number !== 3
+    || job.account !== 'ege_biology' || job.scope !== 'ege_biology_3') fail('wrong factory scope');
+  if (!Number.isSafeInteger(job.amino_acids) || job.amino_acids < 1 || job.amino_acids > 240)
+    fail('scene supports 1..240 amino acids; do not silently substitute or sample');
+  if (job.answer_nucleotides !== job.amino_acids * 3) fail('answer does not equal amino_acids × 3');
+  if (job.target !== 'one-template-strand' || job.include_stop_codon !== false)
+    fail('this scene only explains coding nucleotides in one template strand, excluding stop codon');
+  if (![60, 120].includes(job.render_fps) || job.playback_speed !== 1)
+    fail('render_fps must be 60/120 and approved pacing must remain 1');
+  text(job.condition_text, 'condition_text', 700);
+  if (!Array.isArray(job.step_titles) || job.step_titles.length !== 3) fail('exactly three scene steps required');
+  job.step_titles.forEach((title, i) => text(title, `step_titles[${i}]`, 36));
+  if (!Array.isArray(job.triplet_letters) || job.triplet_letters.length !== 3
+    || job.triplet_letters.some(letter => !['А', 'Т', 'Г', 'Ц'].includes(letter)))
+    fail('triplet_letters must contain three DNA bases');
+  const tl = job.timeline;
+  if (!tl || !number(tl.total) || tl.total <= 0 || tl.total > 90
+    || !number(tl.introSec) || tl.introSec !== 2) fail('invalid timeline duration/intro');
+  if (!tl.marks || !Array.isArray(tl.sentences)) fail('measured timeline required');
+  const byId = new Map();
+  let previousEnd = 0;
+  for (const sentence of tl.sentences) {
+    if (!sentence || typeof sentence.id !== 'string' || byId.has(sentence.id)
+      || !number(sentence.start) || !number(sentence.end)
+      || sentence.start < previousEnd - .001 || sentence.end <= sentence.start
+      || sentence.end > tl.total || typeof sentence.text !== 'string') fail('invalid/overlapping sentences');
+    byId.set(sentence.id, sentence);
+    previousEnd = sentence.end;
+  }
+  if ([...byId.keys()].join(',') !== 'c1,c2,pause,s1,s2,s3,cta') fail('unsupported sentence structure');
+  for (const sentence of tl.sentences) {
+    if (sentence.id === 'pause') {
+      if (sentence.text !== '' || sentence.end - sentence.start < 5.6 - .001)
+        fail('approved pause animation requires at least 5.6 seconds');
+    } else text(sentence.text, `sentence ${sentence.id}`, 1500);
+  }
+  let previous = -Infinity;
+  for (const key of requiredMarks) {
+    const value = tl.marks[key];
+    if (!number(value) || value < previous || value < 0 || value > tl.total)
+      fail(`missing/out-of-order mark ${key}`);
+    previous = value;
+  }
+  const ranges = {c1:['bel','quantity','amino'], c2:['q','dna','code'],
+    s1:['h1','trip','three'], s2:['h2','x3','calc','result'],
+    s3:['h3','tpl','two','fin','answer'], cta:['cta','link']};
+  for (const [id, keys] of Object.entries(ranges)) {
+    const sentence = byId.get(id);
+    for (const key of keys) if (tl.marks[key] < sentence.start - .001 || tl.marks[key] > sentence.end + .001)
+      fail(`mark ${key} is outside measured sentence ${id}`);
+  }
+  if (tl.marks.h1 < byId.get('pause').start + 5.6 || tl.marks.cta + 2.6 > tl.total)
+    fail('insufficient time for pause/CTA choreography');
+  const referenceTiming = job.reference_only === true && job.amino_acids === 120
+    && job.audio?.timing_source === 'approved-prefix-estimates';
+  if (!job.audio || (!referenceTiming && job.audio.timing_source !== 'measured-word-alignment')
+    || !/^[a-f0-9]{64}$/.test(job.audio.sha256 || '')
+    || !number(job.audio.duration_seconds) || Math.abs(job.audio.duration_seconds - tl.total) > .08)
+    fail('audio hash, duration and measured timing provenance required');
+  return job;
+}
+
+// The frozen timeline is permitted ONLY for reconstruction of the original
+// sample. This helper never invents timings for a new voiceover.
+export function makeApprovedReferenceJob(timeline, audioHash) {
+  const tl = structuredClone(timeline);
+  for (const [oldKey, key] of [['n120','quantity'], ['r360','result'], ['a360','answer']]) {
+    tl.marks[key] = tl.marks[oldKey]; delete tl.marks[oldKey];
+  }
+  return validateJob({version: VERSION, scene_family: FAMILY, task_id:'approved-reference-120',
+    exam:'ЕГЭ',subject:'биология',task_number:3,account:'ege_biology',scope:'ege_biology_3',
+    amino_acids:120,answer_nucleotides:360,target:'one-template-strand',include_stop_codon:false,
+    render_fps:60,playback_speed:1,
+    condition_text:'Белок состоит из 120 аминокислот. Сколько нуклеотидов матричной цепи ДНК, кодирующей этот белок?',
+    step_titles:['Триплет','Умножаем','Одна цепь'],triplet_letters:['Т','А','Ц'],timeline:tl,
+    audio:{timing_source:'approved-prefix-estimates',sha256:audioHash,duration_seconds:tl.total},
+    reference_only:true});
+}
