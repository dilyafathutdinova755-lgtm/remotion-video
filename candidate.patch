@@ -0,0 +1,33 @@
+#!/usr/bin/env node
+// Offline PCM assembly. Exact sample copies, with digital silence inserted.
+import fs from 'node:fs';
+import path from 'node:path';
+import {execFileSync} from 'node:child_process';
+import {createHash} from 'node:crypto';
+import {fileURLToPath} from 'node:url';
+export function assemblePcm(source,timeline,sampleRate=48000) {
+ if (!Buffer.isBuffer(source) || source.length%4 || timeline?.version!=='bio-measured-timeline-v1'
+   || timeline.playback_speed!==1 || timeline.pause?.duration!==5.6 || timeline.intro_seconds!==2
+   || !Number.isFinite(timeline.total) || timeline.total>90 || timeline.total<=0
+   || !Number.isFinite(timeline.pause.source_seconds)) throw new Error('Invalid measured PCM timeline');
+ const intro=Math.round(timeline.intro_seconds*sampleRate)*4;
+ const pause=Math.round(timeline.pause.duration*sampleRate)*4;
+ const split=Math.round(timeline.pause.source_seconds*sampleRate)*4;
+ const total=Math.ceil(timeline.total*sampleRate)*4;
+ if(split<0||split>source.length||total<intro+pause+source.length)throw new Error('Audio does not fit measured timeline');
+ const output=Buffer.alloc(total);
+ source.copy(output,intro,0,split); source.copy(output,intro+split+pause,split);
+ return {output,introBytes:intro,pauseBytes:pause,splitBytes:split};
+}
+if(process.argv[1] && path.resolve(process.argv[1])===fileURLToPath(import.meta.url)) {
+ const [timelineFile,inputFile,outputFile]=process.argv.slice(2).map(p=>path.resolve(p));
+ if(!timelineFile||!inputFile||!outputFile||inputFile===outputFile)throw new Error('Use prepare-audio.mjs timeline.json input.mp3 output.wav');
+ const timeline=JSON.parse(fs.readFileSync(timelineFile,'utf8')), input=fs.readFileSync(inputFile);
+ if(createHash('sha256').update(input).digest('hex')!==timeline.audio.sha256)throw new Error('Voice bytes differ from measured input');
+ const pcm=execFileSync('ffmpeg',['-v','error','-i',inputFile,'-f','f32le','-ac','1','-ar','48000','-'],{maxBuffer:100*1024*1024});
+ const {output,...mapping}=assemblePcm(pcm,timeline);
+ if(Math.abs(pcm.length/4/48000-timeline.audio.duration_seconds)>.08)throw new Error('Decoded voice duration differs');
+ execFileSync('ffmpeg',['-v','error','-y','-f','f32le','-ar','48000','-ac','1','-i','pipe:0','-c:a','pcm_f32le',outputFile],{input:output,maxBuffer:100*1024*1024});
+ fs.writeFileSync(outputFile+'.manifest.json',JSON.stringify({version:'bio-measured-audio-v1',source_sha256:timeline.audio.sha256,output_sha256:createHash('sha256').update(fs.readFileSync(outputFile)).digest('hex'),sample_rate:48000,duration:output.length/4/48000,...mapping},null,2)+'\n');
+ console.log(JSON.stringify({sample_copy_verified:output.subarray(mapping.introBytes,mapping.introBytes+mapping.splitBytes).equals(pcm.subarray(0,mapping.splitBytes))&&output.subarray(mapping.introBytes+mapping.splitBytes+mapping.pauseBytes,mapping.introBytes+mapping.pauseBytes+pcm.length).equals(pcm.subarray(mapping.splitBytes)),duration:output.length/4/48000}));
+}
