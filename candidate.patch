+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import crypto from 'node:crypto';
+import {validateJob,makeApprovedReferenceJob} from './contract.mjs';
+const timeline = JSON.parse(fs.readFileSync(new URL('../timeline.json',import.meta.url),'utf8'));
+const bytes = fs.readFileSync(new URL('../assets/voice.wav',import.meta.url));
+const hash = crypto.createHash('sha256').update(bytes).digest('hex');
+const original = () => makeApprovedReferenceJob(timeline,hash);
+test('frozen reference MP4 and audio match approved manifests',()=>{
+  const mp4=fs.readFileSync(new URL('../approved-v1/bio-video-v1.mp4',import.meta.url));
+  assert.equal(crypto.createHash('sha256').update(mp4).digest('hex'),'1cccfd6351963b001ce31ddd65b4d0411b0c552a767b9f0a30b66f5a37045a0c');
+  assert.equal(hash,'4ee2b07786eb394719a841a69f78aa8a049560e46a895da9100b2c21c682ebed');
+  assert.equal(validateJob(original()).answer_nucleotides,360);
+});
+for(const [name,change] of [
+  ['unrelated chromosome task',j=>j.scene_family='chromosome-count'],
+  ['wrong answer',j=>j.answer_nucleotides=720],
+  ['second DNA strand',j=>j.target='both-strands'],
+  ['stop codon ambiguity',j=>j.include_stop_codon=true],
+  ['wrong account',j=>j.account='ege_russian'],
+  ['reusing reference timing for different count',j=>{j.amino_acids=80;j.answer_nucleotides=240;}],
+  ['silent 1.2x pace change',j=>j.playback_speed=1.2],
+  ['unsupported object count',j=>{j.amino_acids=710;j.answer_nucleotides=2130;}],
+  ['out of bounds timing',j=>j.timeline.marks.answer=99],
+  ['wrong sentence for answer',j=>j.timeline.marks.answer=37.9],
+  ['overlapping voice sentences',j=>j.timeline.sentences[3].start=8],
+  ['missing timing',j=>delete j.timeline.marks.calc],
+  ['old two-second timer incompatible with choreography',j=>j.timeline.sentences[2].end-=3.6],
+]) test('reject '+name,()=>{const j=original();change(j);assert.throws(()=>validateJob(j),/BIO_ADAPTER_STOP/);});
+test('changing fps does not change approved pacing or duration',()=>{
+ const j=original();j.render_fps=120;assert.equal(validateJob(j).timeline.total,timeline.total);
+});
+test('new-job contract accepts different quantities only with new timing provenance',()=>{
+ const j=original();delete j.reference_only;
+ j.task_id='contract-fixture-only-80';j.amino_acids=80;j.answer_nucleotides=240;
+ j.condition_text='Белок состоит из 80 аминокислот. Сколько кодирующих нуклеотидов в матричной цепи ДНК?';
+ // Structural fixture only: this does NOT claim real new audio was produced.
+ j.audio.timing_source='measured-word-alignment';
+ j.timeline.sentences[0].text='Белок состоит из восьмидесяти аминокислот.';
+ j.timeline.sentences[4].text='Восемьдесят умножаем на три: двести сорок.';
+ j.timeline.sentences[5].text='В одной матричной цепи двести сорок нуклеотидов.';
+ assert.equal(validateJob(j).answer_nucleotides,240);
+});
