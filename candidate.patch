@@ -0,0 +1,53 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {buildMeasuredTimeline} from './elevenlabs-timeline.mjs';
+// Synthetic timing fixture only; never presented as generated speech.
+function fixture() {
+  const texts=['Начало.','Условие.','два плюс два. Ответ: четыре.','Конец.'];
+  const ids=['intro','task','step-1','cta'];
+  const transcript=texts.join('\n\n'), characters=Array.from(transcript);
+  const alignment={characters,character_start_times_seconds:characters.map((_,i)=>i*.1),character_end_times_seconds:characters.map((_,i)=>i*.1+.08)};
+  let cursor=0;
+  const segments=texts.map((tts_text,i)=>({id:ids[i],tts_text,kind:i===2?'solution':ids[i]}));
+  const timings=segments.map(s=>{
+    const start=cursor,end=cursor+s.tts_text.length;
+    const spokenIndices=Array.from({length:end-start},(_,i)=>start+i).filter(i=>/[\p{L}\p{N}]/u.test(characters[i]));
+    cursor=end+2;
+    return {...s,start_sec:alignment.character_start_times_seconds[spokenIndices[0]],end_sec:alignment.character_end_times_seconds[spokenIndices.at(-1)]};
+  });
+  return {payload:{id:'synthetic-timing-fixture',exam:'ЕГЭ',subject:'биология',task_number:3,scope:'ege_biology_3',account:'ege_biology',condition_text:'Условие.',solution_steps:[{id:'step-1'}],narration_segments:segments,voiceover_tts_text:transcript,narration_timing:{source:'elevenlabs-character-alignment-v1',segments:timings}},alignment,audioBytes:new Uint8Array(1000),audioDuration:characters.length*.1};
+}
+test('preserves speech intervals; inserts approved intro and pause without speed-up',()=>{
+ const f=fixture(), {timeline}=buildMeasuredTimeline(f);
+ assert.equal(timeline.playback_speed,1); assert.equal(timeline.render_fps,60);
+ assert.equal(timeline.pause.duration,5.6);
+ for(const s of timeline.segments) {
+   assert.ok(Math.abs((s.end-s.start)-(s.source_end-s.source_start))<1e-6);
+   assert.ok(Math.abs(s.start-s.source_start-(s.id==='intro'||s.id==='task'?2:7.6))<1e-6);
+ }
+});
+test('answer uses actual character time, not step start or proportional estimate',()=>{
+ const f=fixture(), {cue}=buildMeasuredTimeline(f);
+ const c=cue('step-1','Ответ: четыре.');
+ const expected=f.payload.voiceover_tts_text.indexOf('Ответ:');
+ assert.equal(c.source_start,expected*.1); assert.equal(c.start,Math.round((expected*.1+7.6)*1e6)/1e6);
+});
+test('rejects ambiguous repeated phrase; occurrence resolves explicitly',()=>{
+ const {cue}=buildMeasuredTimeline(fixture());
+ assert.throws(()=>cue('step-1','ва',0),/word/);
+ assert.throws(()=>cue('step-1','несуществующее'),/missing/);
+ assert.throws(()=>cue('step-1','два'),/ambiguous/);
+ assert.ok(cue('step-1','два',1).start > cue('step-1','два',0).end);
+});
+for(const [name,mutate] of [
+ ['other account',f=>f.payload.account='ege_russian'],
+ ['stale transcript',f=>f.payload.voiceover_tts_text+=' '],
+ ['stale alignment',f=>f.alignment.characters[0]='Х'],
+ ['fabricated factory timing',f=>f.payload.narration_timing.segments[2].start_sec+=.2],
+ ['overlapping segments',f=>f.alignment.character_start_times_seconds[20]=0],
+ ['audio too short',f=>f.audioDuration=1],
+ ['over 90 seconds',f=>f.audioDuration=90],
+ ['empty audio',f=>f.audioBytes=new Uint8Array(10)],
+ ['incorrect step identity',f=>f.payload.solution_steps[0].id='step-2'],
+ ['missing actual TTS text',f=>delete f.payload.narration_segments[1].tts_text],
+]) test('rejects '+name,()=>{const f=fixture();mutate(f);assert.throws(()=>buildMeasuredTimeline(f),/BIO_TIMING_STOP/);});
