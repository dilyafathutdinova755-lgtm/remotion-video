+import {validateLesson} from './contract.mjs';
+const fixture=()=>JSON.parse(fs.readFileSync(new URL('./job.json',import.meta.url)));
+test('mitosis preview preserves chromosome count and measured answer time',()=>{
+ const job=validateLesson(fixture());assert.equal(job.answer,26);assert.equal(job.cues.answer.start,49.199);
+});
+for(const [name,change] of [
+ ['different answer',j=>j.answer=52],['wrong ploidy',j=>j.ploidy=2],['stale source quantity',j=>{j.chromosomes=30;j.answer=30;}],['oversized count',j=>{j.chromosomes=121;j.answer=121;}],
+ ['different biological process',j=>j.condition_text=j.condition_text.replace('митоза','мейоза')],
+ ['answer shown before explanation',j=>j.cues.answer.start=0],
+ ['changed scope',j=>j.scope='ege_russian'],['speedup',j=>j.playback_speed=1.2],
+ ['stale protein job',j=>j.scene_family='protein-template-nucleotides']
+])test('reject '+name,()=>{const j=fixture();change(j);assert.throws(()=>validateLesson(j),/BIO_LESSON_STOP/);});
