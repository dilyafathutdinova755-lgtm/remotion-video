+++ b/biology-three-v2/visual-check.mjs
@@ -0,0 +1,23 @@
+// This produces inspection frames only, never a separate demonstration video.
+import http from 'node:http';import fs from 'node:fs';import path from 'node:path';import {fileURLToPath} from 'node:url';import {chromium} from 'playwright';
+const HERE=path.dirname(fileURLToPath(import.meta.url)),ROOT=path.dirname(HERE),OUT=path.join(HERE,'out','qa');fs.mkdirSync(OUT,{recursive:true});
+const job=JSON.parse(fs.readFileSync(path.join(HERE,'job.json')));
+const server=http.createServer((req,res)=>{const p=path.join(ROOT,decodeURIComponent(req.url.split('?')[0]));if(!p.startsWith(ROOT+path.sep)){res.writeHead(403);return res.end();}fs.readFile(p,(err,data)=>{if(err){res.writeHead(404);return res.end();}const ext=path.extname(p);res.setHeader('Content-Type',['.mjs','.js'].includes(ext)?'text/javascript':ext==='.html'?'text/html':ext==='.json'?'application/json':'application/octet-stream');res.end(data);});});
+await new Promise(r=>server.listen(0,'127.0.0.1',r));
+const browser=await chromium.launch({args:['--use-angle=swiftshader','--enable-unsafe-swiftshader','--ignore-gpu-blocklist','--force-color-profile=srgb']});
+try{
+ const page=await browser.newPage({viewport:{width:1080,height:1920}}),errors=[];page.on('pageerror',e=>errors.push(String(e)));page.on('console',m=>{if(m.type()==='error')errors.push(m.text());});
+ await page.goto(`http://127.0.0.1:${server.address().port}/biology-three-v2/index.html`);await page.waitForFunction(()=>window.ready===true,null,{timeout:60000});
+ const checks=[],answerIndex=job.storyboard.scenes.findIndex(s=>s.kind==='answer');
+ const times=[0,...job.narration_timing.segments.map(s=>s.start_sec+.45),job.narration_timing.segments[answerIndex].start_sec-1/60];
+ for(const [i,t]of times.entries()){
+  const state=await page.evaluate(t=>{window.renderFrame(t);return window.BIO_V2_STATE;},t);
+  if(state.overflow.length)throw new Error('Layout overflow '+JSON.stringify(state));
+  if(t===0&&(state.kind!=='visual-condition'||!state.object_ids.length))throw new Error('Opening must show objects');
+  if(t<job.narration_timing.segments[answerIndex].start_sec&&state.unknown_value!==null)throw new Error('Premature answer');
+  await page.screenshot({path:path.join(OUT,`${String(i).padStart(2,'0')}-${state.kind}.png`)});checks.push(state);
+ }
+ if(errors.length)throw new Error(errors.join('\n'));
+ fs.writeFileSync(path.join(OUT,'checks.json'),JSON.stringify(checks,null,2));
+ console.log(JSON.stringify({frames:checks.length,opening:'objects at t0',unknown:'hidden before answer',overflow:false}));
+}finally{await browser.close();server.close();}
