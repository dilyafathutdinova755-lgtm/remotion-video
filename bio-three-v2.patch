+if(!((job.run_mode==='test'&&job.publication_allowed===false)||(job.run_mode==='production'&&job.publication_allowed===true))||job.audio_processing?.transforms!==1)throw new Error('Test/output policy');
+const out=new URL('out/',here),video=new URL('video.mp4',out).pathname;
+execFileSync('ffmpeg',['-y','-v','error','-i',new URL('video-silent.mp4',out).pathname,'-i',new URL('voice-1.3.wav',out).pathname,'-filter_complex','[1:a]apad[a]','-map','0:v:0','-map','[a]','-c:v','copy','-c:a','aac','-b:a','192k','-ar','48000','-t',String(job.duration_seconds),'-movflags','+faststart',video]);
+const probe=JSON.parse(execFileSync('ffprobe',['-v','error','-show_streams','-show_format','-of','json',video],{encoding:'utf8'}));
