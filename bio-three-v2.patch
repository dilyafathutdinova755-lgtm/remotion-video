+if(!a||v?.width!==1080||v.height!==1920||v.avg_frame_rate!=='60/1'||Math.abs(Number(probe.format.duration)-job.duration_seconds)>.12)throw new Error('Output media contract');
+execFileSync('ffmpeg',['-v','error','-i',video,'-f','null','-']);
+fs.writeFileSync(new URL('probe.json',out),JSON.stringify(probe,null,2));
+fs.writeFileSync(new URL('result.json',out),JSON.stringify({version:'biology-three-v2',scope:job.scope,account:job.account,task_id:job.id,run_mode:job.run_mode,publication_allowed:job.publication_allowed,status:'rendered',duration_seconds:Number(probe.format.duration),render_fps:60,playback_speed:1,speech_speed:1.3,render_sha256:createHash('sha256').update(fs.readFileSync(video)).digest('hex'),audio_provenance:job.audio_provenance},null,2));
