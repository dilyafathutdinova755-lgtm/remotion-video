+import fs from 'node:fs';import {execFileSync} from 'node:child_process';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';
+import {validateStoryboard} from './contract.mjs';
+const HERE=path.dirname(fileURLToPath(import.meta.url));
+export function prepareJob(data,audioPath,out=path.join(HERE,'out')){
+ const job=structuredClone(validateStoryboard(data)),tl=job.narration_timing;
+ if(!((job.run_mode==='test'&&job.publication_allowed===false)||(job.run_mode==='production'&&job.publication_allowed===true)))throw new Error('Explicit consistent run mode required');
+ if(tl?.source!=='elevenlabs-character-alignment-v2'||tl.source_speed!==1||tl.speech_speed!==1.3||tl.transform_applied!==false)throw new Error('Audio must be original speed1, unprocessed');
+ if(job.audio_policy?.transform!=='ffmpeg-atempo-once'||job.audio_policy?.source_speed!==1||job.audio_policy?.effective_speed!==1.3||job.audio_policy?.video_speed!==1)throw new Error('Audio policy');
+ if(!Array.isArray(tl.segments)||tl.segments.length!==job.narration_segments.length)throw new Error('Missing measured timing');
+ let end=0;
+ for(const [i,s]of tl.segments.entries()){
+  if(s.id!==job.narration_segments[i].id||s.kind!==job.narration_segments[i].kind||s.tts_text!==job.narration_segments[i].tts_text||![s.source_start_sec,s.source_end_sec,s.start_sec,s.end_sec].every(Number.isFinite)||s.start_sec<end||s.end_sec<=s.start_sec||Math.abs(s.start_sec-s.source_start_sec/1.3)>.001||Math.abs(s.end_sec-s.source_end_sec/1.3)>.001)throw new Error('Inconsistent measured timeline');end=s.end_sec;
+ }
+ if(job.narration_segments.map(s=>s.tts_text).join('\n\n')!==job.voiceover_tts_text)throw new Error('Transcript changed');
+ for(const k of ['correct','visual_safe','unknown_hidden','source_preserved','speech_matches_visuals'])if(job.biology_verification?.[k]!==true)throw new Error('Independent review missing');
+ fs.mkdirSync(out,{recursive:true});
+ const probe=p=>JSON.parse(execFileSync('ffprobe',['-v','error','-show_entries','format=duration','-of','json',p],{encoding:'utf8'})).format.duration*1;
+ const duration=probe(audioPath);if(!Number.isFinite(duration)||duration<=0||duration>240||tl.segments.at(-1).source_end_sec>duration+.1)throw new Error('Audio/timing duration mismatch');
+ const voice=path.join(out,'voice-1.3.wav');
+ execFileSync('ffmpeg',['-y','-v','error','-i',audioPath,'-vn','-af','atempo=1.3','-ar','48000','-ac','2',voice]);
+ const effective=probe(voice);if(Math.abs(effective-duration/1.3)>.16)throw new Error('Wrong audio speed');
+ job.duration_seconds=Math.ceil(Math.max(effective+.35,tl.segments.at(-1).start_sec+3.65)*60)/60;
+ if(job.duration_seconds>180)throw new Error('Job too long');
+ job.audio_provenance={source_sha256:createHash('sha256').update(fs.readFileSync(audioPath)).digest('hex'),source_duration:duration,effective_duration:effective,effective_speed:1.3,transforms:1,filter:'atempo=1.3'};
+ // Keep source metadata unchanged, record applied processing separately. Rejecting input
+ // transform_applied=true makes a second pass impossible without falsifying the job.
+ job.audio_processing={transform_applied:true,transforms:1,video_speed:1};
+ fs.writeFileSync(path.join(HERE,'job.json'),JSON.stringify(job,null,2));
+ fs.writeFileSync(path.join(out,'prepared-job.json'),JSON.stringify(job,null,2));
+ return {job,voice};
+}
+if(process.argv[1]===fileURLToPath(import.meta.url)){
+ const [json,audio]=process.argv.slice(2);if(!json||!audio)throw new Error('Usage: prepare.mjs TASK_JSON ORIGINAL_AUDIO');
+ const r=prepareJob(JSON.parse(fs.readFileSync(json)),audio);console.log(JSON.stringify({task_id:r.job.id,duration:r.job.duration_seconds,speech_speed:1.3,video_speed:1}));
+}
