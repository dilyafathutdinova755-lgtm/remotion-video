+++ b/biology-three-v2/contract.mjs
@@ -0,0 +1,53 @@
+export const VERSION = 'biology-three-v2';
+export const TYPES = ['fern','cell','chromosomes','dna','protein','nucleotides','atp','seed'];
+export function validateStoryboard(data) {
+ const stop=m=>{throw new Error('BIO_V2_STOP: '+m);};
+ const str=(v,max,k)=>{if(typeof v!=='string'||!v.trim()||v.length>max)stop(k);};
+ if(data?.video_structure_version!==VERSION||data.scope!=='ege_biology_3'||data.account!=='ege_biology'||data.exam!=='ЕГЭ'||Number(data.task_number)!==3)stop('scope/version');
+ if(data.render_fps!==60||data.playback_speed!==1||data.speech_speed!==1.3)stop('audio/video speed');
+ for(const k of ['id','source_reservation_id','source_history_commit','condition_text','answer','explanation'])str(data[k],k==='condition_text'?1600:2500,k);
+ if(!/^(?:\d+(?:[.,]\d+)?|[АТГЦУ]+)$/u.test(data.answer))stop('answer');
+ const sb=data.storyboard;
+ if(!sb||sb.version!=='bio-storyboard-v2'||!Array.isArray(sb.scenes))stop('storyboard');
+ str(sb.unknown_object_id,50,'unknown object');
+ const scenes=sb.scenes;
+ if(scenes.length<5||scenes.length>13)stop('scene count');
+ const kinds=scenes.map(s=>s.kind);
+ if(kinds[0]!=='visual-condition'||kinds[1]!=='condition'||kinds.at(-2)!=='answer'||kinds.at(-1)!=='cta'||kinds.slice(2,-2).some(k=>k!=='solution'))stop('scene order: visual, condition, solution, answer, cta');
+ const ids=new Set(); let unknownSeen=false;
+ for(const [i,s] of scenes.entries()){
+  str(s.id,50,'scene id');if(!/^[a-z][a-z0-9-]*$/.test(s.id)||ids.has(s.id))stop('scene identity');ids.add(s.id);
+  str(s.voiceover_text,1600,'scene narration');
+  if(/решаем задание|биология\s*[—-]\s*задание|из приложения/iu.test(s.voiceover_text)&&i===0)stop('intro forbidden');
+  if(s.kind==='condition'&&s.voiceover_text!==data.condition_text)stop('condition narration must preserve source');
+  if(['condition','cta'].includes(s.kind)){if(s.objects?.length)stop('objects in text/cta');continue;}
+  str(s.headline,90,'scene headline');
+  if(!Array.isArray(s.objects)||!s.objects.length||s.objects.length>3)stop('visual objects');
+  if(!['compare','highlight','pair','split','assemble'].includes(s.action))stop('unsupported animation');
+  if(s.relation!==undefined&&(typeof s.relation!=='string'||s.relation.length>100))stop('relation');
+  const oi=new Set();
+  for(const o of s.objects){
+   str(o.id,50,'object id');if(oi.has(o.id))stop('duplicate object');oi.add(o.id);
+   if(!TYPES.includes(o.type))stop('unsupported model '+o.type);
+   str(o.label,65,'object label');
+   if(o.value!==null&&(typeof o.value!=='string'||!o.value.trim()||o.value.length>45))stop('object value');
+   if(typeof o.unit!=='string'||o.unit.length>40)stop('unit');
+   if(!['given','unknown','derived'].includes(o.role))stop('object role');
+   if(o.id===sb.unknown_object_id){unknownSeen=true;if(i<scenes.length-2&&(o.value!==null||o.count!==undefined))stop('premature answer/geometry');}
+   if(i===0&&o.role==='derived')stop('derived fact in opening');
+   if(o.role==='unknown'&&i<scenes.length-2&&o.value!==null)stop('unknown leaked');
+   if(o.count!==undefined&&(!Number.isSafeInteger(o.count)||o.count<1||o.count>120||!['cell','chromosomes'].includes(o.type)))stop('exact chromosome count');
+   if(o.strands!==undefined&&(![1,2].includes(o.strands)||o.type!=='dna'))stop('DNA strands');
+   if(o.chromatids_per_chromosome!==undefined&&(![1,2].includes(o.chromatids_per_chromosome)||!['cell','chromosomes'].includes(o.type)))stop('chromatids');
+   if(o.sequence!==undefined&&(!/^[АТГЦУ]{1,24}$/u.test(o.sequence)||!['dna','nucleotides'].includes(o.type)))stop('sequence');
+  }
+  if(i===0&&!oi.has(sb.unknown_object_id))stop('opening must show question object');
+ }
+ if(!unknownSeen)stop('unknown missing');
+ const answer=scenes.at(-2).objects.find(o=>o.id===sb.unknown_object_id);
+ if(!answer||answer.value!==data.answer)stop('answer scene disagrees');
+ const narr=data.narration_segments;
+ if(!Array.isArray(narr)||narr.length!==scenes.length||narr.some((s,i)=>s.id!==scenes[i].id||s.kind!==scenes[i].kind||s.text!==scenes[i].voiceover_text))stop('storyboard/narration mismatch');
+ if(narr.map(s=>s.text).join('\n\n')!==data.voiceover_text)stop('transcript mismatch');
+ return data;
+}
