+import fs from 'node:fs';import path from 'node:path';import http from 'node:http';import{fileURLToPath}from'node:url';import{chromium}from'playwright';import{PNG}from'pngjs';
+const HERE=path.dirname(fileURLToPath(import.meta.url)),ROOT=path.dirname(HERE),job=JSON.parse(fs.readFileSync(path.join(HERE,'job.json')));
+const server=http.createServer((req,res)=>{const p=path.join(ROOT,decodeURIComponent(req.url.split('?')[0]));if(!p.startsWith(ROOT+path.sep)){res.writeHead(403);return res.end();}fs.readFile(p,(e,b)=>{if(e){res.writeHead(404);return res.end();}const ex=path.extname(p);res.setHeader('Content-Type',['.js','.mjs'].includes(ex)?'text/javascript':ex==='.html'?'text/html':ex==='.json'?'application/json':'application/octet-stream');res.end(b);});});
+await new Promise(r=>server.listen(0,'127.0.0.1',r));
+const args=['--use-angle=swiftshader','--enable-unsafe-swiftshader','--ignore-gpu-blocklist','--force-color-profile=srgb'];
+const variants=[{name:'reference-full',full:true,extra:[],surface:true},{name:'cropped-instanced',full:false,extra:[],surface:true},{name:'software-compositor',full:false,extra:['--disable-gpu-compositing'],surface:true},{name:'view-capture',full:false,extra:['--disable-gpu-compositing'],surface:false}];
+const times=[0,...job.narration_timing.segments.map(s=>s.start_sec+.45)],screens=[],results=[];
+try{
+ for(const v of variants){
+  const browser=await chromium.launch({args:[...args,...v.extra]});
+  try{
+   const page=await browser.newPage({viewport:{width:1080,height:1920},deviceScaleFactor:1});
+   await page.goto(`http://127.0.0.1:${server.address().port}/biology-three-v2/index.html${v.full?'?fullViewport=1':''}`);await page.waitForFunction(()=>window.ready===true,null,{timeout:60000});
+   const cdp=await page.context().newCDPSession(page),shot=async format=>Buffer.from((await cdp.send('Page.captureScreenshot',{format,quality:format==='jpeg'?94:undefined,optimizeForSpeed:true,fromSurface:v.surface,clip:{x:0,y:0,width:1080,height:1920,scale:1}})).data,'base64');
+   const frames=[];for(const t of times){await page.evaluate(t=>window.renderFrame(t),t);frames.push(PNG.sync.read(await shot('png')));}
+   screens.push(frames);let renderMs=0,captureMs=0;const start=performance.now();
+   for(let i=0;i<20;i++){let t=performance.now();await page.evaluate(t=>window.renderFrame(t),.7+i/60);renderMs+=performance.now()-t;t=performance.now();await shot('jpeg');captureMs+=performance.now()-t;}
+   results.push({mode:v.name,seconds:(performance.now()-start)/1000,render_ms:renderMs/20,capture_ms:captureMs/20,frames:20});
+  }finally{await browser.close();}
+ }
+ const diffs=screens.map((frames,j)=>({mode:variants[j].name,scenes:frames.map((b,i)=>{const a=screens[0][i];if(a.width!==b.width||a.height!==b.height)return{scene:i,dimensions:false};let total=0,bad=0;for(let p=0;p<a.data.length;p+=4){let max=0;for(let c=0;c<3;c++){const d=Math.abs(a.data[p+c]-b.data[p+c]);total+=d;max=Math.max(max,d);}if(max>8)bad++;}return{scene:i,mean_rgb_difference:total/(1080*1920*3),pixels_over_8_fraction:bad/(1080*1920)};})}));
+ const accepted=diffs.map((d,i)=>({...results[i],pixel_regression_passed:d.scenes.every(s=>s.dimensions!==false&&s.mean_rgb_difference<=.5&&s.pixels_over_8_fraction<=.003)}));
+ console.log(JSON.stringify({accepted,diffs},null,2));
+ if(!accepted[1].pixel_regression_passed)throw Error('Native crop changed pixels beyond tolerance');
+ fs.mkdirSync(path.join(HERE,'out'),{recursive:true});fs.writeFileSync(path.join(HERE,'out','raster-benchmark.json'),JSON.stringify({accepted,diffs},null,2));
+}finally{server.close();}
